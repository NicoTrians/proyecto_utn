<!-- Preguntas Frecuentes -->
<div class="container my-5 py-4 custom-faq" style="max-width: 900px;">
  <h2 class="text-center fw-bold mb-5" style="color: #002244; letter-spacing: 1px;">PREGUNTAS FRECUENTES</h2>

  <div class="accordion accordion-flush" id="faqAccordion">

    <!-- Item 1 -->
    <div class="accordion-item">
      <h2 class="accordion-header" id="faq-heading-1">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
          data-bs-target="#faq-collapse-1" aria-expanded="false" aria-controls="faq-collapse-1">
          ¿Qué es Banco UTN y a quién está dirigido?
        </button>
      </h2>
      <div id="faq-collapse-1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
        <div class="accordion-body text-muted">
          Es una plataforma pensada para brindar soluciones financieras dinámicas e integrales a estudiantes, docentes y
          graduados.
        </div>
      </div>
    </div>

    <!-- Item 2 -->
    <div class="accordion-item">
      <h2 class="accordion-header" id="faq-heading-2">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
          data-bs-target="#faq-collapse-2" aria-expanded="false" aria-controls="faq-collapse-2">
          ¿Qué requisitos necesito para abrir una cuenta?
        </button>
      </h2>
      <div id="faq-collapse-2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
        <div class="accordion-body text-muted">
          Solo necesitás ser mayor de 18 años, contar con DNI argentino vigente y validar tu identidad desde la app
          móvil.
        </div>
      </div>
    </div>

    <!-- Item 3 -->
    <div class="accordion-item">
      <h2 class="accordion-header" id="faq-heading-3">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
          data-bs-target="#faq-collapse-3" aria-expanded="false" aria-controls="faq-collapse-3">
          ¿La cuenta tiene costos de mantenimiento o comisiones?
        </button>
      </h2>
      <div id="faq-collapse-3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
        <div class="accordion-body text-muted">
          No, la apertura y el mantenimiento mensual de la caja de ahorro son 100% bonificados.
        </div>
      </div>
    </div>

    <!-- Item 4 -->
    <div class="accordion-item">
      <h2 class="accordion-header" id="faq-heading-4">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
          data-bs-target="#faq-collapse-4" aria-expanded="false" aria-controls="faq-collapse-4">
          ¿Cómo genero mi clave de eBank por primera vez?
        </button>
      </h2>
      <div id="faq-collapse-4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
        <div class="accordion-body text-muted">
          Podés generarla desde cualquier cajero automático de la red en la opción Gestión de Claves > Home Banking.
        </div>
      </div>
    </div>

    <!-- Item 5 -->
    <div class="accordion-item">
      <h2 class="accordion-header" id="faq-heading-5">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
          data-bs-target="#faq-collapse-5" aria-expanded="false" aria-controls="faq-collapse-5">
          ¿Desde qué momento puedo usar mi cuenta?
        </button>
      </h2>
      <div id="faq-collapse-5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
        <div class="accordion-body text-muted">
          Una vez finalizada la validación de identidad, la cuenta queda activa al instante para recibir transferencias
          e ingresar dinero.
        </div>
      </div>
    </div>

  </div>
</div>
<!-- Preguntas Frecuentes end -->