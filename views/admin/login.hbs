<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-11 col-sm-10 col-md-8 col-lg-6">
      
      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4 p-md-5">
          
          <ul class="nav nav-pills mb-4 justify-content-center" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link {{#unless tabRegistro}}active{{/unless}}" id="pills-login-tab" data-bs-toggle="pill" data-bs-target="#pills-login" type="button" role="tab" aria-controls="pills-login" aria-selected="{{#if tabRegistro}}false{{else}}true{{/if}}">Iniciar Sesión</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link {{#if tabRegistro}}active{{/if}}" id="pills-register-tab" data-bs-toggle="pill" data-bs-target="#pills-register" type="button" role="tab" aria-controls="pills-register" aria-selected="{{#if tabRegistro}}true{{else}}false{{/if}}">Registrarse</button>
            </li>
          </ul>

          <div class="tab-content" id="pills-tabContent">
            
            <!-- Tab Iniciar Sesión -->
            <div class="tab-pane fade {{#unless tabRegistro}}show active{{/unless}}" id="pills-login" role="tabpanel" aria-labelledby="pills-login-tab" tabindex="0">
              <h2 class="fw-bold mb-3 text-center">Iniciar Sesión</h2>
              
              <form class="row g-3" action="/login" method="POST">
                {{#if error}}
                  <div class="col-12">
                    <div class="alert alert-danger mb-0" role="alert">
                      {{message}}
                    </div>
                  </div>
                {{/if}}

                {{#if success}}
                  <div class="col-12">
                    <div class="alert alert-success mb-0" role="alert">
                      {{message}}
                    </div>
                  </div>
                {{/if}}

                <div class="col-12">
                  <label for="loginDni" class="form-label fw-semibold">DNI</label>
                  <input type="number" class="form-control" id="loginDni" name="dni" placeholder="Ingresá tu DNI" required>
                </div>
                
                <div class="col-12">
                  <label for="loginPassword" class="form-label fw-semibold">Contraseña</label>
                  <input type="password" class="form-control" id="loginPassword" name="password" placeholder="Ingresá tu contraseña" required>
                </div>
                
                <div class="col-12 text-center mt-4">
                  <button type="submit" class="btn btn-primary px-4 w-100 py-2">Ingresar</button>
                </div>
              </form>
            </div>

            <!-- Tab Registrarse (Crear Usuario) -->
            <div class="tab-pane fade {{#if tabRegistro}}show active{{/if}}" id="pills-register" role="tabpanel" aria-labelledby="pills-register-tab" tabindex="0">
              <h2 class="fw-bold mb-3 text-center">Crear Usuario</h2>
              
              <form class="row g-3" action="/login/registro" method="POST">
                {{#if errorRegistro}}
                  <div class="col-12">
                    <div class="alert alert-danger mb-0" role="alert">
                      {{messageRegistro}}
                    </div>
                  </div>
                {{/if}}

                <div class="col-md-6">
                  <label for="regNombre" class="form-label fw-semibold">Nombre</label>
                  <input type="text" class="form-control" id="regNombre" name="nombre" value="{{formData.nombre}}" placeholder="Ingresá tu nombre" required>
                </div>

                <div class="col-md-6">
                  <label for="regApellido" class="form-label fw-semibold">Apellido</label>
                  <input type="text" class="form-control" id="regApellido" name="apellido" value="{{formData.apellido}}" placeholder="Ingresá tu apellido" required>
                </div>

                <div class="col-md-6">
                  <label for="regEdad" class="form-label fw-semibold">Edad</label>
                  <input type="number" class="form-control" id="regEdad" name="edad" value="{{formData.edad}}" placeholder="Tu edad" min="1" max="120" required>
                </div>

                <div class="col-md-6">
                  <label for="regDni" class="form-label fw-semibold">DNI</label>
                  <input type="number" class="form-control" id="regDni" name="dni" value="{{formData.dni}}" placeholder="Sin puntos ni espacios" required>
                </div>

                <div class="col-12">
                  <label for="regDireccion" class="form-label fw-semibold">Dirección</label>
                  <input type="text" class="form-control" id="regDireccion" name="direccion" value="{{formData.direccion}}" placeholder="Calle, número, ciudad" required>
                </div>

                <div class="col-md-6">
                  <label for="regCelular" class="form-label fw-semibold">Celular</label>
                  <input type="number" class="form-control" id="regCelular" name="celular" value="{{formData.celular}}" placeholder="Ej: 1112345678" required>
                </div>

                <div class="col-md-6">
                  <label for="regPassword" class="form-label fw-semibold">Contraseña</label>
                  <input type="password" class="form-control" id="regPassword" name="password" placeholder="Creá una contraseña" required>
                </div>

                <div class="col-12 text-center mt-4">
                  <button type="submit" class="btn btn-success px-4 w-100 py-2">Crear Cuenta</button>
                </div>
              </form>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>